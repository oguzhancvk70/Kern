;; komut "upper" / "lower": seçimi ASCII büyük/küçük harfe çevirir
(module
  (import "kern" "ctx_get" (func $ctx_get (param i32 i32 i32 i32) (result i32)))
  (import "kern" "action" (func $action (param i32 i32 i32 i32) (result i32)))
  (memory (export "memory") 17)
  (data (i32.const 0) "selection")
  (data (i32.const 16) "replace_selection")
  (global $heap (mut i32) (i32.const 1024))
  (func (export "kern_alloc") (param $n i32) (result i32)
    (local $p i32)
    (local.set $p (global.get $heap))
    (global.set $heap (i32.add (global.get $heap) (local.get $n)))
    (local.get $p))
  (func (export "kern_command") (param $id i32) (param $idn i32) (result i32)
    (local $len i32) (local $i i32) (local $c i32) (local $upper i32) (local $lo i32) (local $hi i32) (local $d i32)
    (local.set $upper (i32.eq (i32.load8_u (local.get $id)) (i32.const 117)))
    (if (local.get $upper)
      (then (local.set $lo (i32.const 97)) (local.set $hi (i32.const 122)) (local.set $d (i32.const -32)))
      (else (local.set $lo (i32.const 65)) (local.set $hi (i32.const 90)) (local.set $d (i32.const 32))))
    (local.set $len (call $ctx_get (i32.const 0) (i32.const 9) (i32.const 65536) (i32.const 1048576)))
    (if (i32.gt_s (local.get $len) (i32.const 1048576)) (then (return (i32.const 1))))
    (block $done
      (loop $next
        (br_if $done (i32.ge_u (local.get $i) (local.get $len)))
        (local.set $c (i32.load8_u (i32.add (i32.const 65536) (local.get $i))))
        (if (i32.and (i32.ge_u (local.get $c) (local.get $lo)) (i32.le_u (local.get $c) (local.get $hi)))
          (then (i32.store8 (i32.add (i32.const 65536) (local.get $i)) (i32.add (local.get $c) (local.get $d)))))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br $next)))
    (drop (call $action (i32.const 16) (i32.const 17) (i32.const 65536) (local.get $len)))
    (i32.const 0)))
